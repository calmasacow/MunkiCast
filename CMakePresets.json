{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 28, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "environment": {
        "PATH": "${sourceDir}/build/ffmpeg-9.1/prefix/bin:$penv{PATH}"
      },
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "LIBERTAS_DEPS": "system"
      }
    },
    {
      "name": "linux",
      "displayName": "Linux (Arch/Omarchy bedrock)",
      "inherits": "base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "RelWithDebInfo" }
    },
    {
      "name": "linux-ffmpeg-9.1",
      "displayName": "Linux FFmpeg 9.1 (compatibility preset)",
      "inherits": "linux-ci"
    },
    {
      "name": "linux-system-ffmpeg",
      "displayName": "Linux with system FFmpeg (rollback)",
      "inherits": "linux",
      "cacheVariables": { "LIBERTAS_USE_SYSTEM_FFMPEG": "ON" },
      "environment": { "PATH": "$penv{PATH}" }
    },
    {
      "name": "linux-debug",
      "displayName": "Linux debug",
      "inherits": "base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "linux-ci",
      "displayName": "Linux CI (warnings are errors)",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "LIBERTAS_WERROR": "ON"
      }
    },
    {
      "name": "linux-asan",
      "displayName": "Linux ASan+UBSan",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "LIBERTAS_SANITIZE": "ON",
        "LIBERTAS_WERROR": "ON"
      }
    },
    {
      "name": "linux-tsan",
      "displayName": "Linux TSan (ring harness; cannot see cross-process shm)",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "LIBERTAS_TSAN": "ON",
        "LIBERTAS_WERROR": "ON"
      }
    }
  ],
  "buildPresets": [
    { "name": "linux", "configurePreset": "linux" },
    { "name": "linux-ffmpeg-9.1", "configurePreset": "linux-ffmpeg-9.1" },
    { "name": "linux-system-ffmpeg", "configurePreset": "linux-system-ffmpeg" },
    { "name": "linux-debug", "configurePreset": "linux-debug" },
    { "name": "linux-ci", "configurePreset": "linux-ci" },
    { "name": "linux-asan", "configurePreset": "linux-asan" },
    { "name": "linux-tsan", "configurePreset": "linux-tsan" }
  ],
  "testPresets": [
    {
      "name": "linux",
      "configurePreset": "linux",
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error", "stopOnFailure": false }
    },
    {
      "name": "linux-ffmpeg-9.1",
      "configurePreset": "linux-ffmpeg-9.1",
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error", "stopOnFailure": false }
    },
    {
      "name": "linux-system-ffmpeg",
      "configurePreset": "linux-system-ffmpeg",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "linux-ci",
      "configurePreset": "linux-ci",
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error", "stopOnFailure": false }
    },
    {
      "name": "linux-asan",
      "configurePreset": "linux-asan",
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error" }
    },
    {
      "name": "linux-tsan",
      "configurePreset": "linux-tsan",
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error" },
      "filter": { "exclude": { "label": "needs-qt-threads" } }
    }
  ]
}
